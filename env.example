# Required for every AI feature (grading, prompts, quizzes, management sims)
# Free key: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Optional: which Gemini model to use (default: gemini-flash-latest)
GEMINI_MODEL=

# Optional but recommended: unlimited random YouTube clips in Commentary Practice
# (Google Cloud console -> enable "YouTube Data API v3" -> create an API key)
YOUTUBE_API_KEY=

# Members section (PUSD Google sign-in)
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Add your site URL (e.g. https://scc-avhs.vercel.app) to "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=
# The secret code in your invite link: https://YOUR-SITE/?join=THIS_CODE#members
MEMBER_INVITE_CODE=
# Only accounts on this domain can join
ALLOWED_EMAIL_DOMAIN=pleasantonusd.net
# Comma-separated officer emails (can see the full member list + invite link)
OFFICER_EMAILS=ap4956@pleasantonusd.net,wb6525@pleasantonusd.net,gkramer@pleasantonusd.net

# Member storage: Upstash Redis (Vercel Marketplace -> Upstash for Redis sets these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=
